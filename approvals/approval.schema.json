{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ata:design:v1.1:approvals:approval.schema.json",
  "title": "Bounded Approval",
  "description": "Action-bound, versioned approval; material modification invalidates approval.",
  "x-design-status": "proposed-not-validated-by-phase-a-engine",
  "x-source-documents": [
    "ATA Reference Architecture v1.2",
    "Policy Schema & Authority Model v1.1"
  ],
  "x-original-source-documents": [
    "ATA Reference Architecture v1.1",
    "Policy Schema & Authority Model v1.0"
  ],
  "x-document-baseline": "Baseline Manifest v1.1 (2026-10-08); editorial alignment only",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "action_hash": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "principal_id",
        "role"
      ],
      "additionalProperties": true
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "conditions": {
      "type": "object",
      "properties": {
        "max_amount": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "approval_id",
    "version",
    "action_id",
    "action_hash",
    "approver",
    "decision",
    "timestamp",
    "conditions",
    "expires_at"
  ],
  "additionalProperties": true
}
