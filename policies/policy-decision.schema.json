{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ata:design:v1.1:policies:policy-decision.schema.json",
  "title": "Policy Decision",
  "description": "Deterministic governance result with versioned inputs and reason codes.",
  "x-design-status": "proposed-not-validated-by-phase-a-engine",
  "x-source-documents": [
    "ATA Reference Architecture v1.2",
    "Policy Schema & Authority Model v1.1"
  ],
  "x-original-source-documents": [
    "ATA Reference Architecture v1.1",
    "Policy Schema & Authority Model v1.0"
  ],
  "x-document-baseline": "Baseline Manifest v1.1 (2026-10-08); editorial alignment only",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "action_hash": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "REQUIRE_ADDITIONAL_INFORMATION"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluated_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "policy_id",
          "version"
        ],
        "additionalProperties": true
      }
    },
    "evaluated_authority_envelope": {
      "type": "object",
      "properties": {
        "envelope_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "envelope_id",
        "version"
      ],
      "additionalProperties": true
    },
    "treasury_state_version": {
      "type": "string",
      "minLength": 1
    },
    "approval_state_ref": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "context_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "decision_id",
    "action_id",
    "outcome",
    "reason_codes",
    "evaluated_policies",
    "evaluated_authority_envelope",
    "treasury_state_version",
    "evaluation_timestamp"
  ],
  "additionalProperties": true
}
