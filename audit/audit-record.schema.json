{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ata:design:v1.1:audit:audit-record.schema.json",
  "title": "Audit Record",
  "description": "Structured audit event; a hash chain is local integrity evidence, not tamper-proof attestation.",
  "x-design-status": "proposed-not-validated-by-phase-a-engine",
  "x-source-documents": [
    "ATA Reference Architecture v1.2",
    "Policy Schema & Authority Model v1.1"
  ],
  "x-original-source-documents": [
    "ATA Reference Architecture v1.1",
    "Policy Schema & Authority Model v1.0"
  ],
  "x-document-baseline": "Baseline Manifest v1.1 (2026-10-08); editorial alignment only",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id"
      ],
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "treasury_state_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_envelope_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "policies": {
      "type": "object",
      "properties": {
        "evaluated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "policy_id",
              "version"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previous_event_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "event_id",
    "correlation_id",
    "timestamp",
    "stage",
    "actor"
  ],
  "additionalProperties": true
}
