{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ata:design:v1.1:execution:proposed-action.schema.json",
  "title": "Proposed Action",
  "description": "Structured financial intent. Passing this schema never grants execution authority.",
  "x-design-status": "proposed-not-validated-by-phase-a-engine",
  "x-source-documents": [
    "ATA Reference Architecture v1.2",
    "Policy Schema & Authority Model v1.1"
  ],
  "x-original-source-documents": [
    "ATA Reference Architecture v1.1",
    "Policy Schema & Authority Model v1.0"
  ],
  "x-document-baseline": "Baseline Manifest v1.1 (2026-10-08); editorial alignment only",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "proposed_by": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "principal_id"
      ],
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_id"
      ],
      "additionalProperties": true
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "destination": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "amount": {
      "type": "object",
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "denomination": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "denomination"
      ],
      "additionalProperties": true
    },
    "proposed_rail": {
      "type": "string",
      "minLength": 1
    },
    "settlement": {
      "type": "object",
      "properties": {
        "requested_by": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "rationale": {
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "treasury_state_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "action_id",
    "proposed_by",
    "entity",
    "action_type",
    "amount",
    "treasury_state_ref"
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "execute"
        ]
      },
      {
        "required": [
          "authorized_instruction"
        ]
      },
      {
        "required": [
          "idempotency_key"
        ]
      }
    ]
  }
}
